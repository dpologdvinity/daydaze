{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.minigames.config.ts"
  ],
  "exclude": ["server/src/worker", "server/worker-configuration.d.ts"]
}
