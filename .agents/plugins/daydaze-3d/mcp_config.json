{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    },
    "threejs-devtools-mcp": {
      "command": "npx",
      "args": [
        "threejs-devtools-mcp",
        "--scope",
        "project"
      ]
    }
  }
}
