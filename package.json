{
  "name": "daydaze",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-isolation=none \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --experimental-strip-types --test --test-isolation=none --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/summary.txt --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck:server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm test && npm run typecheck && npm run format:check && npm run build",
    "typecheck:server": "wrangler types --config server/wrangler.jsonc server/worker-configuration.d.ts > /dev/null && tsc --noEmit -p server",
    "dev:server": "vite build && wrangler dev --config server/wrangler.jsonc",
    "smoke:server": "node server/scripts/smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test -c playwright.minigames.config.ts",
    "test:e2e:client": "playwright test",
    "test:e2e:online": "playwright test -c playwright.online.config.ts",
    "test:e2e:sw": "playwright test -c playwright.sw.config.ts",
    "perf:budget": "node --experimental-strip-types scripts/perf-budget.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cloudflare": "^7.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gltfjsx": "^6.5.3",
    "prettier": "^3.9.9",
    "three-stdlib": "^2.36.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@three.ez/instanced-mesh": "^0.3.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
