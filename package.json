{
  "name": "daydaze",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-isolation=none \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && npm run typecheck:server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm test && npm run typecheck && npm run format:check",
    "typecheck:server": "wrangler types --config server/wrangler.jsonc server/worker-configuration.d.ts > /dev/null && tsc --noEmit -p server",
    "dev:server": "vite build && wrangler dev --config server/wrangler.jsonc",
    "smoke:server": "node server/scripts/smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "playwright test -c playwright.minigames.config.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
