{
  "name": "daydaze",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --experimental-strip-types --test --experimental-test-isolation=none --experimental-test-coverage --test-coverage-lines=96 --test-coverage-branches=92 --test-coverage-functions=92 --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/summary.txt --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/**/*.test.ts\" && node --experimental-strip-types scripts/check-coverage.ts",
    "lint": "npm run types:server && eslint . --cache --cache-location .cache/eslint/",
    "lint:spelling": "cspell --no-progress",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc.tsbuildinfo && npm run typecheck:server",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier",
    "lint:deps": "depcruise src server/src --config .dependency-cruiser.cjs",
    "lint:headers": "node --experimental-strip-types scripts/check-headers.ts",
    "lint:dead": "knip",
    "lint:md": "markdownlint-cli2",
    "verify": "npm run lint && npm run lint:md && npm run lint:dead && npm run lint:headers && npm run lint:deps && npm run lint:spelling && npm test && npm run typecheck && npm run format:check && npm run build && npm run perf:budget",
    "types:server": "wrangler types --config server/wrangler.jsonc server/worker-configuration.d.ts > /dev/null",
    "typecheck:server": "npm run types:server && tsc --noEmit -p server --incremental --tsBuildInfoFile .cache/tsc-server.tsbuildinfo",
    "dev:server": "vite build && wrangler dev --config server/wrangler.jsonc",
    "smoke:server": "node server/scripts/smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test -c playwright.minigames.config.ts",
    "test:e2e:client": "playwright test",
    "test:e2e:online": "playwright test -c playwright.online.config.ts",
    "test:e2e:sw": "playwright test -c playwright.sw.config.ts",
    "perf:budget": "node --experimental-strip-types scripts/perf-budget.ts",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cspell": "^10.5.2",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@three.ez/instanced-mesh": "^0.3.16",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "sharp": "^0.35.5",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
