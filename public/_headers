# Applied by Cloudflare Workers static assets to every asset response.
# No inline scripts: the Vite build emits only external module scripts.
# 'unsafe-inline' styles are for React style props.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints everything under /assets/ (a new build, a new name), so
# browsers may keep those files for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31556952, immutable
