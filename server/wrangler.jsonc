{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "daydaze",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomInstance" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomInstance", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
  ],
  "vars": {
    // Browser origins allowed to call /api and open room sockets, besides the
    // Worker's own origin. Production overrides this with the real site.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daydaze",
      // Local placeholder: replace with the id from `wrangler d1 create daydaze` before any deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // The Vite build. Asset requests skip the Worker (free, and dist/_headers
  // adds the CSP); only the API and room sockets run Worker code.
  "assets": {
    "directory": "../dist",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
}
