{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "daydaze",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomInstance" },
      { "name": "DIRECTORY", "class_name": "Directory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomInstance", "Directory"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daydaze",
      // Local placeholder: replace with the id from `wrangler d1 create daydaze` before any deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // shortcut: no static assets yet; add "assets": { "directory": "../dist" } once the Vite app builds here.
}
